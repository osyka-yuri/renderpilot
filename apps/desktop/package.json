{
  "name": "renderpilot-desktop-ui",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build && pnpm run check:bundle",
    "check:bundle": "node scripts/check-bundle-graph.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "pnpm run i18n:test && pnpm run release:test && vitest run",
    "test:a11y": "pnpm run build && pnpm run test:a11y:no-build",
    "test:a11y:no-build": "playwright test",
    "release:test": "node --test scripts/release-manifest.test.mjs scripts/portable-rpu.test.mjs scripts/portable-runtime-release-contract.test.mjs",
    "typecheck": "pnpm run i18n:check && svelte-check --tsconfig ./tsconfig.json",
    "i18n:generate": "node scripts/generate-i18n-contracts.mjs --write",
    "i18n:check": "node scripts/generate-i18n-contracts.mjs --check",
    "i18n:source-check": "node scripts/check-external-source-contracts.mjs",
    "i18n:review": "node scripts/i18n-review.mjs",
    "i18n:test": "node --test scripts/i18n-contracts.test.mjs scripts/external-source-contracts.test.mjs scripts/i18n-review.test.mjs scripts/i18n-bundle-boundaries.test.mjs scripts/accessibility-contracts.test.mjs",
    "docs:check": "markdownlint-cli2 --config ../../.markdownlint-cli2.jsonc ../../README.md ../../CONTRIBUTING.md \"../../docs/**/*.md\" && node --test scripts/check-docs.test.mjs && node scripts/check-docs.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:oxlint": "oxlint ui/src scripts e2e playwright.config.ts --deny-warnings",
    "lint:eslint": "eslint . --cache --max-warnings 0 --concurrency auto",
    "lint:fix": "pnpm run lint:oxlint:fix && pnpm run lint:eslint:fix",
    "lint:oxlint:fix": "oxlint ui/src scripts e2e playwright.config.ts --fix --deny-warnings",
    "lint:eslint:fix": "eslint . --cache --fix --max-warnings 0 --concurrency auto"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^1.39.0",
    "@tanstack/svelte-store": "^0.12.1",
    "@tanstack/svelte-virtual": "^3.13.36",
    "@tanstack/table-core": "^9.2.4",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.6",
    "bits-ui": "^2.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte": "5.57.0",
    "svelte-dnd-action": "0.9.79",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "26.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "jsonc-parser": "3.3.1",
    "markdownlint-cli2": "0.23.2",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "svelte-eslint-parser": "^1.8.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "^4.1.11"
  }
}
