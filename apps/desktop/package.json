{
  "name": "renderpilot-desktop-ui",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build && pnpm run check:bundle",
    "check:bundle": "node scripts/check-bundle-graph.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "pnpm run i18n:test && vitest run",
    "typecheck": "pnpm run i18n:check && svelte-check --tsconfig ./tsconfig.json",
    "i18n:generate": "node scripts/generate-i18n-contracts.mjs --write",
    "i18n:check": "node scripts/generate-i18n-contracts.mjs --check",
    "i18n:source-check": "node scripts/check-external-source-contracts.mjs",
    "i18n:review": "node scripts/i18n-review.mjs",
    "i18n:test": "node --test scripts/i18n-contracts.test.mjs scripts/external-source-contracts.test.mjs scripts/i18n-review.test.mjs scripts/i18n-bundle-boundaries.test.mjs",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "pnpm run lint:oxlint && pnpm run lint:eslint",
    "lint:oxlint": "oxlint ui/src --deny-warnings",
    "lint:eslint": "eslint . --cache --max-warnings 0 --concurrency auto",
    "lint:fix": "pnpm run lint:oxlint:fix && pnpm run lint:eslint:fix",
    "lint:oxlint:fix": "oxlint ui/src --fix --deny-warnings",
    "lint:eslint:fix": "eslint . --cache --fix --max-warnings 0 --concurrency auto"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.28.0",
    "@tanstack/svelte-virtual": "^3.13.35",
    "@tanstack/table-core": "^8.21.3",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "bits-ui": "^2.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "mode-watcher": "^1.1.0",
    "svelte": "5.56.8",
    "svelte-dnd-action": "0.9.76",
    "svelte-sonner": "^1.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "oxlint-tsgolint": "^7.0.2001",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "^4.1.10"
  }
}
